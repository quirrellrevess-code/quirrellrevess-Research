<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/darker_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:scrollbarSize="1dp"
        android:id="@+id/list"
        android:background="@android:color/background_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/translucent"
        android:dividerHeight="1dp"
        android:layout_above="@+id/menuOptionsLayout"
        android:fastScrollEnabled="true"
        android:fastScrollAlwaysVisible="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/menuOptionsLayout"
        android:background="@android:color/white"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottombar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/filterLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="100dp">
            <TextView
                android:textColor="@android:color/black"
                android:gravity="center_vertical"
                android:background="@android:color/holo_green_dark"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/logfilter_lable"
                android:layout_weight="0.3"/>
            <EditText
                android:textSize="20sp"
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/etLogFilter"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:maxLines="1"
                android:layout_weight="0.4"/>
            <Button
                android:textColor="@android:color/black"
                android:id="@+id/btnLogFilter"
                android:background="@android:color/holo_green_dark"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/logfilter_button"
                android:layout_weight="0.3"/>
        </LinearLayout>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/rgPriorityLevels"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/radioVerbose"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/priority_verbose"/>
            <RadioButton
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/radioDebug"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_debug"/>
            <RadioButton
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/radioInfo"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_info"/>
            <RadioButton
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/radioWarning"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_warning"/>
            <RadioButton
                android:textColor="@android:color/holo_green_dark"
                android:id="@+id/radioError"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority_error"/>
        </RadioGroup>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/bottombar"
        android:background="@android:color/darker_gray"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/normalbottombar"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/pause"
                android:background="@mipmap/pause"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"/>
            <ImageView
                android:id="@+id/play"
                android:background="@mipmap/play"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"/>
            <ImageView
                android:id="@+id/find"
                android:background="@mipmap/find"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"/>
            <ImageView
                android:id="@+id/btnPriorityLevel"
                android:background="@mipmap/prioritylevels"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"/>
            <ImageView
                android:id="@+id/btnReset"
                android:background="@mipmap/reset"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginRight="10dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
