<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp">
        <LinearLayout
            android:id="@+id/engineLayout"
            style="@style/main_card_view">
            <TextView
                android:text="@string/engine_type"
                style="@style/main_label_header"/>
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/engineSel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/switch_byhandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/switch_byhandle"
                    android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                    style="@style/main_label"/>
                <RadioButton
                    android:id="@+id/switch_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/switch_root"
                    android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                    style="@style/main_label"/>
                <RadioButton
                    android:id="@+id/switch_wza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/switch_wza"
                    android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                    style="@style/main_label"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="1dp"
            style="@style/main_card_view">
            <TextView
                android:text="@string/runenv_type"
                style="@style/main_label_header"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_accessibility"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_opensnap"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_opensnap"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/use_automator_lay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/use_automator"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/use_automator"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_openrootengine"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_openrootengine"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_bootstart"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_bootstart"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_vol"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_vol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_virbate"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_virbate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_showonoff"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_showonoff"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_openime"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_openime"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/runRootEnvLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/local_engine"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_rootengine"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout style="@style/main_card_view">
            <TextView
                android:text="@string/other_option"
                style="@style/main_label_header"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_autosavelog"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_autosavelog"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_addfileinfo"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_addfileinfo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:text="@string/switch_openloglist"
                    style="@style/main_label"/>
                <CheckBox
                    android:id="@+id/switch_openloglist"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/version_info"
                    android:text="@string/version"
                    style="@style/text_label"/>
                <TextView
                    android:id="@+id/version"
                    android:layout_marginRight="5dp"
                    android:text="1.0.2"
                    android:layout_alignParentRight="true"
                    style="@style/text_label"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout style="@style/main_card_view">
            <TextView
                android:text="@string/debug_option"
                style="@style/main_label_header"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/localDbgLayout"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/localip"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="@string/localip"
                    style="@style/debug_panel"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/localipaddr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/localip"
                    android:layout_weight="1"
                    style="@style/debug_panel"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="100dp"
                    android:layout_height="match_parent">
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/port"
                        style="@style/debug_panel"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/local_port"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/local_port"
                        android:layout_weight="1"
                        style="@style/debug_panel"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:text="@string/ipaddr"
                    style="@style/debug_panel"/>
                <EditText
                    android:textColorHint="@color/hintcolor"
                    android:gravity="center"
                    android:id="@+id/ipaddr"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"
                    android:hint="@string/host"
                    android:layout_weight="1"
                    style="@style/debug_panel"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="100dp"
                    android:layout_height="match_parent">
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/port"
                        style="@style/debug_panel"/>
                    <EditText
                        android:textColorHint="@color/hintcolor"
                        android:gravity="center"
                        android:id="@+id/port"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/port_default"
                        android:inputType="number"
                        style="@style/debug_panel"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:textSize="@dimen/dimen_14"
                android:textColor="@color/white"
                android:id="@+id/connect"
                android:background="@drawable/draw_button_rect"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/connect"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
