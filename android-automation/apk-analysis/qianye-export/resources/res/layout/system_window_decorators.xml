<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@drawable/background"
    android:padding="1dp"
    android:layout_width="200dp"
    android:layout_height="200dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/titlebar"
        android:background="@android:color/darker_gray"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/window_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/window_icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="Title"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/hide"
            android:background="@mipmap/hide"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="10dp"
            android:contentDescription="@string/hide"/>
        <ImageView
            android:id="@+id/maximize"
            android:background="@mipmap/maximize"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="5dp"
            android:contentDescription="@string/maximize"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/titlebar"/>
    <ImageView
        android:id="@+id/corner"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@mipmap/corner"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/corner"/>
</RelativeLayout>
