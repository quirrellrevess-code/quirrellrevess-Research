<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llcontrol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="1dp">
        <LinearLayout
            android:id="@+id/img_control_mask"
            style="@style/floatview_contain_style">
            <ImageView
                android:id="@+id/img_control"
                android:src="@mipmap/ic_launcher"
                style="@style/floatview_imageview"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_control"
            android:background="@color/translucent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/llrun"
            android:layout_marginLeft="8dp"
            style="@style/floatview_linearlayout">
            <LinearLayout style="@style/floatview_contain_style">
                <ImageView
                    android:id="@+id/img_run"
                    android:src="@mipmap/img_start"
                    style="@style/floatview_imageview"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvrun_or_stop"
                android:text="@string/tv_runorstop"
                style="@style/floatview_textview"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llpause"
            style="@style/floatview_linearlayout">
            <LinearLayout style="@style/floatview_contain_style">
                <ImageView
                    android:id="@+id/img_pause"
                    android:src="@mipmap/img_pause"
                    style="@style/floatview_imageview"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_pause"
                android:text="@string/tv_pause"
                style="@style/floatview_textview"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llsettings"
            style="@style/floatview_linearlayout">
            <LinearLayout style="@style/floatview_contain_style">
                <ImageView
                    android:id="@+id/img_settings"
                    android:src="@mipmap/img_setting"
                    style="@style/floatview_imageview"/>
            </LinearLayout>
            <TextView
                android:text="@string/tv_settings"
                style="@style/floatview_textview"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lluserevent"
            style="@style/floatview_linearlayout">
            <LinearLayout style="@style/floatview_contain_style">
                <ImageView
                    android:id="@+id/img_event"
                    android:src="@mipmap/img_event"
                    style="@style/floatview_imageview"/>
            </LinearLayout>
            <TextView
                android:text="@string/tv_event"
                style="@style/floatview_textview"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llexit"
            style="@style/floatview_linearlayout">
            <LinearLayout style="@style/floatview_contain_style">
                <ImageView
                    android:id="@+id/img_exit"
                    android:src="@mipmap/img_exit"
                    style="@style/floatview_imageview"/>
            </LinearLayout>
            <TextView
                android:text="@string/tv_exitapp"
                style="@style/floatview_textview"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
