<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/calview"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <TextView
                android:textSize="@dimen/title_font_size"
                android:textColor="@color/ui_show_primary_text_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="窗口标题"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:background="#66aaaaaa"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/uicontain_page"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/uicontain_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.p000nx.baseui.SlidingTabLayout
            android:id="@+id/slidingTabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.p000nx.baseui.ViewPagerEx
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/laybottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="14sp"
                android:textColor="@color/ui_show_primary_text_color"
                android:id="@+id/exit"
                android:background="@drawable/bg_exit_button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginRight="-1dp"
                android:text="@string/ui_show_negative_button_label"
                android:layout_weight="1"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/ui_show_primary_text_color"
                android:id="@+id/next"
                android:background="@drawable/bg_continue_button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/ui_show_positive_button_label"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
