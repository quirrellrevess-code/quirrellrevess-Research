<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>UmaAutoTrainingPlugin</AssemblyName>
    <RootNamespace>UmaAutoTrainingPlugin</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <UraReferenceDir Condition="'$(UraReferenceDir)' == ''">$(MSBuildThisFileDirectory)..\URA</UraReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UmamusumeResponseAnalyzer"><HintPath>$(UraReferenceDir)\UmamusumeResponseAnalyzer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(UraReferenceDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Spectre.Console"><HintPath>$(UraReferenceDir)\Spectre.Console.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyPluginToUraPlugins" AfterTargets="Build" Condition="'$(UraPluginDir)' != ''">
    <MakeDir Directories="$(UraPluginDir)\UmaAutoTrainingPlugin" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UraPluginDir)\UmaAutoTrainingPlugin" />
  </Target>
</Project>
